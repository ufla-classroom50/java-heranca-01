# ==============================================================================
# CLASSROOM50 AUTOGRADER - VARIÁVEIS DE AMBIENTE PARA DESENVOLVIMENTO LOCAL
# ==============================================================================
# Instruções: Copie este arquivo para um novo arquivo chamado '.env' 
# e preencha as variáveis com suas credenciais reais.
# Comando: cp .env.template .env
# ==============================================================================

# Sua chave da API do Google Gemini (Obtenha em: https://aistudio.google.com/)
GEMINI_API_KEY=sua_chave_gemini_aqui

# Token de Acesso Pessoal do GitHub (PAT Classic com escopo 'repo')
# Necessário apenas se for testar a busca do gabarito privado localmente via script
GABARITO_TOKEN=ghp_seu_token_aqui

# Tag da Imagem Docker do Autograder
DOCKER_IMAGE_VERSION=v2.0

# Repositório de Gabaritos Privados
GABARITOS_REPO=ufla-classroom50/gabaritos-privados